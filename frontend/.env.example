# Frontend environment variables
VITE_API_URL=http://localhost:3000

# Analytics (optional, off by default).
# Set VITE_ANALYTICS_PROVIDER to "umami" or "google" and fill in that
# provider's values below. Leave it unset and no tracker is loaded.
VITE_ANALYTICS_PROVIDER=

# Umami — self-hosted or cloud
VITE_UMAMI_SRC=https://your-umami-instance.example/script.js
VITE_UMAMI_WEBSITE_ID=

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=
